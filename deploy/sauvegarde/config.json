{
  "services": [
    {
      "name": "spettacoli",
      "postgres_container": "spettacoli-db-1",
      "postgres_user": "spettacoli",
      "postgres_password_env": "SPETTACOLI_DB_PASSWORD",
      "postgres_db": "spettacoli",
      "s3_prefix": "spettacoli-backups/",
      "redis_container": null,
      "backup_redis": false,
      "volumes": [
        {
          "source": "/var/lib/docker/volumes/spettacoli_fichiers/_data/public",
          "target": "storage-public"
        }
      ]
    }
  ]
}
