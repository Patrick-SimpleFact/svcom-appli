# Modèle du fichier deploy/.env du serveur (L01). Copier en .env, remplir, ne jamais commiter.
# Lu par docker-compose.yml (variables ${…}) et par les conteneurs app, worker, scheduler.

DOMAINE=spettacoli.spectacles-vivants.com
# Domaine principal : le site public y est aussi servi (www redirigé).
DOMAINE_SITE=spectacles-vivants.com
# Ancien domaine principal, redirigé vers les nouveaux (site et sous-domaine spettacoli.).
ANCIEN_DOMAINE_SITE=spectaclesvivants.com

APP_NAME=Spettacoli
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://spettacoli.spectacles-vivants.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# Journaux vers la sortie des conteneurs : docker compose logs.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Base du conteneur db (réseau interne). Mot de passe long et aléatoire.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=spettacoli
DB_USERNAME=spettacoli
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Alertes et e-mails (SMTP de la messagerie pro de Patrick, A03).
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Sources de la collecte.
AWIN_FEEDLIST_URL=
OPENAGENDA_API_KEY=
DATATOURISME_API_KEY=
TICKETMASTER_CONSUMER_KEY=

# App mobile (bloc 7, M10b, M12b, M16) : à remplir quand les identifiants existent.
APP_STORE_URL=
GOOGLE_PLAY_URL=
APP_STORE_PT=
ANDROID_PACKAGE=
ANDROID_SHA256_FINGERPRINTS=
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_PRODUCTION=true
FCM_CREDENTIALS_PATH=

# Compte de démonstration pour l'examen Google Play / App Store : code fixe (6 chiffres) pour cette seule adresse, sans e-mail.
COMPTE_EXAMEN_EMAIL=
COMPTE_EXAMEN_CODE=

# Assistant IA de la boîte de travail (plan-module-ia) : l'Ollama de l'hôte, joint par la passerelle du réseau « proxy »
# (docker network inspect proxy : Gateway), et la clé ollama.com qui sert seulement à lire le forfait restant.
OLLAMA_URL=http://172.18.0.1:11434
OLLAMA_API_KEY=
