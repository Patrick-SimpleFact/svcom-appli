{
  "info": {
    "name": "Spettacoli — API v1",
    "description": "API de l'app (docs/API.md). Chaque requête envoie X-Appareil et X-App-Version (variables de la collection). En local : désactiver « SSL certificate verification » dans les réglages de Postman (certificat de Herd).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://spettacoli.test/v1"
    },
    {
      "key": "appareil",
      "value": "postman-patrick-0001"
    },
    {
      "key": "version_app",
      "value": "1.0.0"
    },
    {
      "key": "lat",
      "value": "43.9493"
    },
    {
      "key": "lon",
      "value": "4.8055"
    },
    {
      "key": "ville_id",
      "value": "32360"
    }
  ],
  "item": [
    {
      "name": "§2 Démarrage (P01)",
      "item": [
        {
          "name": "Ouvrir l'app (configuration)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Appareil",
                "value": "{{appareil}}"
              },
              {
                "key": "X-App-Version",
                "value": "{{version_app}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Enregistre l'ouverture et renvoie la configuration. latitude/longitude facultatives : messages de service de la commune la plus proche.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plateforme\": \"ios\",\n  \"latitude\": 43.9493,\n  \"longitude\": 4.8055\n}"
            },
            "url": {
              "raw": "{{base_url}}/appareils",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "appareils"
              ]
            }
          }
        },
        {
          "name": "Ouvrir l'app sans position",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Appareil",
                "value": "{{appareil}}"
              },
              {
                "key": "X-App-Version",
                "value": "{{version_app}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plateforme\": \"android\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/appareils",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "appareils"
              ]
            }
          }
        },
