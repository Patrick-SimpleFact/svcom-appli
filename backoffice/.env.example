APP_NAME=Spettacoli
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://spettacoli.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=spettacoli
DB_USERNAME=spettacoli
DB_PASSWORD=spettacoli

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Alertes de supervision (F7.9) : relais SMTP Brevo. En local, MAIL_MAILER=log écrit l'e-mail dans storage/logs/laravel.log.
# Brevo : MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, identifiant et clé SMTP (Brevo › SMTP & API),
# adresse d'expédition d'un domaine vérifié dans Brevo. Essai : php artisan supervision:verifier --essai
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Awin (BilletRéduc, Fnac) : adresse secrète de la liste des flux (COLLECTE §3)
# https://ui.awin.com/productdata-darwin-download/publisher/<id>/<clé>/1/feedList
AWIN_FEEDLIST_URL=

# OpenAgenda : clé d’API (COLLECTE §3)
OPENAGENDA_API_KEY=

# DATAtourisme : clé de l’API REST (api.datatourisme.fr)
DATATOURISME_API_KEY=

# Ticketmaster : clé de l’API Discovery (flux national, COLLECTE §3)
TICKETMASTER_CONSUMER_KEY=

# Connexion à l'app (F1.4, P06) : identifiant de l'app iOS (ex. fr.spettacoli.app) et identifiants clients OAuth Google, séparés par des virgules.
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# Notifications (P11) : clé Apple (.p8) et compte de service Firebase, à créer au bloc 7.
# La même clé .p8 sert à révoquer « Continuer avec Apple » à la suppression du compte (M10b) ; APPLE_KEY_PATH / APPLE_KEY_ID / APPLE_TEAM_ID si une autre clé.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
FCM_CREDENTIALS_PATH=

# Assistant IA (plan-module-ia) : modèles « :cloud » appelés directement sur l'API d'ollama.com avec la clé du compte
# (ollama.com › Settings › Keys), qui sert aussi à lire le forfait restant. Autre possibilité : un Ollama connecté
# au compte (ollama signin), OLLAMA_URL=http://localhost:11434 ; la clé ne sert alors qu'au forfait.
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=

# Liens partagés (W01) : boutiques et ouverture de l'app Android, à renseigner au bloc 7
APP_STORE_URL=
GOOGLE_PLAY_URL=
APP_STORE_PT=
ANDROID_PACKAGE=
ANDROID_SHA256_FINGERPRINTS=
