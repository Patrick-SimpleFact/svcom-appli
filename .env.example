# Copier ce fichier en .env et renseigner les valeurs. Le .env n'est jamais commité.
# Une source dont la variable est vide est simplement ignorée par le POC.

# Ticketmaster Discovery API v2 — developer.ticketmaster.com > My Apps
# Seule la Consumer Key sert (c'est la clé d'API) ; secret et callback ne servent qu'à l'OAuth.
TICKETMASTER_CONSUMER_KEY=
TICKETMASTER_CONSUMER_SECRET=
TICKETMASTER_CALLBACK_URL=

# OpenAgenda — clé publique (Paramètres du compte > API)
OPENAGENDA_API_KEY=
# Optionnel : UIDs d'agendas à interroger en plus de ceux trouvés par recherche, séparés par des virgules
OPENAGENDA_AGENDA_UIDS=

# DATAtourisme — diffuseur.datatourisme.fr : créer un flux filtré sur "Fête et manifestation",
# format JSON. L'URL du flux a la forme .../webservice/<FLUX_ID>/<API_KEY>.
DATATOURISME_API_KEY=
DATATOURISME_FLUX_ID=

# Awin — compte éditeur SimpleFact (BilletRéduc n°20796 et Fnac Spectacles n°12494 rejoints)
# Clé datafeed : Toolbox > Create-a-Feed, c'est la valeur après /apikey/ dans l'URL générée.
# Elle suffit : le POC retrouve lui-même les flux BilletRéduc et Fnac.
AWIN_DATAFEED_KEY=
# Jeton de l'API éditeur (Toolbox > API Credentials) — pas utilisé par le POC, servira pour
# suivre les commissions plus tard.
AWIN_API_TOKEN=

# Que faire à Paris (opendata.paris.fr) — pas de clé nécessaire
